    "test:integration": "node scripts/test-database.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
