{
  "name": "cida-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts",
    "db:generate": "prisma generate",
