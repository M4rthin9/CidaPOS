{
  "name": "cida-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/cloudflare-command.mjs d1 migrations apply cida-pos --local",
    "db:seed": "tsx scripts/seed-d1.ts",
    "db:import:nestle": "tsx scripts/import-nestle-menu.ts",
    "test:integration": "node scripts/test-d1.mjs",
    "test:browser": "playwright test",
    "db:migrate:remote": "node scripts/cloudflare-command.mjs d1 migrations apply cida-pos --remote",
    "db:seed:sql": "tsx scripts/seed-d1.ts --sql-only",
    "cf:build": "prisma generate && opennextjs-cloudflare build && node scripts/prepare-worker.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/cloudflare-command.mjs deploy",
    "cf:setup": "node scripts/cloudflare-setup.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@opennextjs/cloudflare": "^1.20.9",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "aws4fetch": "^1.0.20",
    "miniflare": "^5.20261006.0-alpha",
    "pg": "^8.23.1",
    "prisma": "6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0",
    "sharp": "^0.35.5"
  }
}
